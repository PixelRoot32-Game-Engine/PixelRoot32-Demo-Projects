.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Sprite contact sheets: regenerated on demand, never reviewed in a diff.
# `--preview` writes tools/sprite_preview.png by default; the glob covers an
# explicit path too, so a throwaway sheet cannot end up in a commit.
tools/*.png

# Python bytecode from the art generator (imported by --preview and --check).
tools/__pycache__/
